@model Core.Models.Taskitem
@{
    ViewData["Title"] = "Edit";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-primary fw-bold">
            <i class="fas fa-edit me-2"></i> Edit Task
        </h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i | class="fas fa-arrow-left me-2"></i> Back to List
        </a>
    </div>

    <!-- Edit Form Card -->
    <div class="card border-0 shadow-lg edit-task-card mx-auto" style="max-width: 650px;">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-tasks me-2"></i> Update Task Details
            </h5>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
                <input type="hidden" asp-for="Id" />

                <!-- Title -->
                <div class="form-floating mb-3">
                    <input asp-for="Title" class="form-control" placeholder="Task title" required />
                    <label asp-for="Title">
                        <i class="fas fa-heading me-1"></i> Title
                    </label>
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <!-- Description -->
                <div class="form-floating mb-3">
                    <input asp-for="Description" class="form-control" placeholder="Description (optional)" />
                    <label asp-for="Description">
                        <i class="fas fa-align-left me-1"></i> Description
                    </label>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- IsCompleted -->
                <div class="form-check mb-4">
                    <input class="form-check-input" asp-for="IsCompleted" />
                    <label class="form-check-label fw-medium" asp-for="IsCompleted">
                        <i class="fas fa-check-square me-1"></i> @Html.DisplayNameFor(model => model.IsCompleted)
                    </label>
                </div>

                <!-- Created At (Read-only) -->
                <div class="form-floating mb-4">
                    <input asp-for="CreatedAt" class="form-control" readonly />
                    <label asp-for="CreatedAt">
                        <i class="far fa-calendar-alt me-1"></i> Created On
                    </label>
                    <span asp-validation-for="CreatedAt" class="text-danger small"></span>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fas fa-save me-2"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        .edit-task-card {
            border-radius: 1rem;
            overflow: hidden;
            transition: all 0.3s ease;
        }

            .edit-task-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 20px 40px rgba(0,0,0,0.15) !important;
            }

        .form-floating > label {
            color: #495057;
            font-weight: 500;
        }

        .form-control:focus, .form-check-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        .form-control[readonly] {
            background-color: #f8f9fa;
            opacity: 0.8;
            cursor: not-allowed;
        }

        .btn {
            border-radius: 0.5rem;
            font-weight: 500;
        }

        .alert {
            border-radius: 0.5rem;
            font-size: 0.9rem;
        }

        .was-validated .form-control:invalid,
        .form-control.is-invalid {
            border-color: #dc3545;
        }

        .was-validated .form-control:valid,
        .form-control.is-valid {
            border-color: #198754;
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Bootstrap client-side validation
        (function () {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}