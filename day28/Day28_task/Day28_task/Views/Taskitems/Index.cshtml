@model IEnumerable<Core.Models.Taskitem>
@{
    ViewData["Title"] = "Index";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-primary fw-bold">
            <i class="fas fa-tasks me-2"></i> Task Manager
        </h1>
        <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">
            <i class="fas fa-plus-circle me-2"></i> Add New Task
        </a>
    </div>

    <!-- Filters & Sort Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-8">
                    <small class="text-muted">Filter by status:</small>
                    <div class="btn-group ms-2" role="group">
                        <a href="@Url.Action("Index", new { isCompleted = true })"
                           class="btn btn-outline-success btn-sm @(ViewBag.IsCompleted == true ? "active" : "")">
                            <i class="fas fa-check-circle"></i> Completed
                        </a>
                        <a href="@Url.Action("Index", new { isCompleted = false })"
                           class="btn btn-outline-warning btn-sm @(ViewBag.IsCompleted == false ? "active" : "")">
                            <i class="fas fa-clock"></i> Pending
                        </a>
                        <a href="@Url.Action("Index")"
                           class="btn btn-outline-secondary btn-sm @(ViewBag.IsCompleted == null ? "active" : "")">
                            <i class="fas fa-list-ul"></i> All
                        </a>
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <small class="text-muted">Sort by date:</small>
                    <div class="btn-group ms-2" role="group">
                        <a href="@Url.Action("Index", new { sortOrder = "asc" })"
                           class="btn btn-outline-primary btn-sm @(ViewBag.SortOrder == "asc" ? "active" : "")">
                            <i class="fas fa-sort-up"></i> Ascending
                        </a>
                        <a href="@Url.Action("Index", new { sortOrder = "desc" })"
                           class="btn btn-outline-primary btn-sm @(ViewBag.SortOrder == "desc" ? "active" : "")">
                            <i class="fas fa-sort-down"></i> Descending
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tasks Grid -->
    @if (Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 task-card border-0 shadow-sm @(item.IsCompleted ? "border-success" : "border-warning")
                                 @(item.IsCompleted ? "completed-task" : "")">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0 text-dark fw-semibold">
                                    @Html.DisplayFor(modelItem => item.Title)
                                </h5>
                                <span class="badge @(item.IsCompleted ? "bg-success" : "bg-warning text-dark")">
                                    @(item.IsCompleted ? "Completed" : "Pending")
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <p class="card-text text-muted small flex-grow-1">
                                    @Html.DisplayFor(modelItem => item.Description)
                                </p>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <small class="text-muted">
                                    <i class="far fa-calendar-alt me-1"></i>
                                    @Html.DisplayFor(modelItem => item.CreatedAt)
                                </small>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-outline-primary" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-outline-info" title="Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-outline-danger" title="Delete">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
            <p class="text-muted">No tasks available at the moment.</p>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        .task-card {
            transition: all 0.3s ease;
            border-left: 4px solid transparent !important;
        }

            .task-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
            }

            .task-card.completed-task {
                opacity: 0.95;
                background: linear-gradient(135deg, #f8fff8 0%, #e8f5e8 100%);
                border-left-color: #28a745 !important;
            }

            .task-card:not(.completed-task) {
                background: linear-gradient(135deg, #fffdf0 0%, #fff8e1 100%);
                border-left-color: #ffc107 !important;
            }

        .btn-group .btn {
            border-radius: 0.375rem;
        }

        .badge {
            font-size: 0.75rem;
            padding: 0.35em 0.65em;
        }
    </style>
}

@section Scripts {
    <script>
        // Optional subtle load animation
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('.task-card').forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    card.style.transition = 'all 0.5s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
}