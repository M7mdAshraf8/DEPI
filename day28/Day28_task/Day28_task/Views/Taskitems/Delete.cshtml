@model Core.Models.Taskitem
@{
    ViewData["Title"] = "Delete";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-danger fw-bold">
            <i class="fas fa-trash-alt me-2"></i> Delete Task
        </h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i> Back to List
        </a>
    </div>

    <!-- Delete Confirmation Card -->
    <div class="card border-0 shadow-lg delete-task-card mx-auto" style="max-width: 700px;">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0 d-flex align-items-center">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Confirm Deletion
            </h5>
        </div>

        <div class="card-body p-4">
            <!-- Warning Message -->
            <div class="alert alert-danger border-0 mb-4" role="alert">
                <i class="fas fa-skull-crossbones me-2"></i>
                <strong>Warning:</strong> This action <u>cannot be undone</u>. The task will be permanently deleted.
            </div>

            <!-- Task Preview -->
            <div class="bg-light p-4 rounded mb-4 border-start border-danger border-5">
                <h6 class="text-dark fw-bold mb-3">
                    <i class="fas fa-clipboard-list me-2"></i> Task to be Deleted
                </h6>

                <div class="row g-3">
                    <!-- Title -->
                    <div class="col-12">
                        <div class="d-flex">
                            <strong class="text-muted me-2">Title:</strong>
                            <span class="text-dark fw-semibold">@Html.DisplayFor(m => m.Title)</span>
                        </div>
                    </div>

                    <!-- Description -->
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="col-12">
                            <div class="d-flex">
                                <strong class="text-muted me-2">Description:</strong>
                                <span class="text-muted">@Html.DisplayFor(m => m.Description)</span>
                            </div>
                        </div>
                    }

                    <!-- Status -->
                    <div class="col-md-6">
                        <div class="d-flex align-items-center">
                            <strong class="text-muted me-2">Status:</strong>
                            <span class="badge @(Model.IsCompleted ? "bg-success" : "bg-warning text-dark") px-3 py-1">
                                <i class="@(Model.IsCompleted ? "fas fa-check" : "fas fa-clock") me-1"></i>
                                @(Model.IsCompleted ? "Completed" : "Pending")
                            </span>
                        </div>
                    </div>

                    <!-- Created At -->
                    <div class="col-md-6">
                        <div class="d-flex align-items-center">
                            <strong class="text-muted me-2">Created:</strong>
                            <span class="text-dark">
                                <i class="far fa-calendar-alt me-1"></i>
                                @Html.DisplayFor(m => m.CreatedAt)
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delete Form -->
            <form asp-action="Delete" method="post" class="d-inline">
                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        <i class="fas fa-times me-2"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="fas fa-trash me-2"></i> Yes, Delete Permanently
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        .delete-task-card {
            border-radius: 1rem;
            overflow: hidden;
            transition: all 0.3s ease;
        }

            .delete-task-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 20px 40px rgba(220, 53, 69, 0.2) !important;
            }

        .card-header.bg-danger {
            background: linear-gradient(135deg, #dc3545, #c82333) !important;
        }

        .alert {
            border-radius: 0.75rem;
            font-size: 0.95rem;
        }

        .border-start {
            border-left-width: 6px !important;
        }

        .btn {
            border-radius: 0.5rem;
            font-weight: 500;
            min-width: 160px;
        }

        .btn-danger {
            background: linear-gradient(135deg, #dc3545, #c82333);
            border: none;
        }

            .btn-danger:hover {
                background: linear-gradient(135deg, #c82333, #a71d2a);
                transform: translateY(-1px);
            }

        .badge {
            font-size: 0.85rem;
        }
    </style>
}

@section Scripts {
    <script>
        // Optional: Add shake animation on load for emphasis
        document.addEventListener("DOMContentLoaded", function () {
            const card = document.querySelector('.delete-task-card');
            card.style.animation = 'pulse 2s infinite';
        });

        // Add CSS animation
        const style = document.createElement('style');
        style.textContent = `
            @@keyframes pulse {
                0%, 100% { transform: translateY(0); }
                50% { transform: translateY(-3px); }
            }
        `;
        document.head.appendChild(style);
    </script>
}