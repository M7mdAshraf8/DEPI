@model DeptWithStudentsViewModel
@{
    ViewData["Title"] = "Department Info";
}
<h1>Department Info</h1>
<h2>Name: @Model.DeptName</h2>
<h3>State: @Model.DeptState</h3>

<label>Students above 25:</label>
<select class="form-control">
    @foreach (var student in Model.StudentsAbove25)
    {
        <option>@student</option>
    }
</select>

<a href="/Department/ShowAll" class="btn btn-secondary mt-3">Back to List</a>

