@model Department
@{
    ViewData["Title"] = "Add Department";
}

<h1>Add Department</h1>

<form method="post" asp-action="SaveAdd" asp-controller="Department">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="form-group mb-2">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="MgrName" class="form-label"></label>
        <input asp-for="MgrName" class="form-control" />
        <span asp-validation-for="MgrName" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Create</button>
    <a asp-action="ShowAll" class="btn btn-secondary mt-2">Back to List</a>
</form>
