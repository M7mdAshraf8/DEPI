@model StudentDeptViewModel
@{
    ViewData["Title"] = "Edit Student";
}

<h1>Edit Student</h1>

<form method="post" asp-action="SaveEdit" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger mb-2"></div>

    <div class="mb-2">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Age" class="form-label"></label>
        <input asp-for="Age" class="form-control" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="DepartmentId" class="form-label"></label>
        <select asp-for="DepartmentId" asp-items="Model.DeptList" class="form-control">
            <option value="0">-- Select Department --</option>
        </select>

        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Back</a>
</form>

