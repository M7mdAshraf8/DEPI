@model StudentIndexViewModel

<h1>Students</h1>

<form method="get" asp-action="Index" asp-controller="Student" class="row mb-3">
    <div class="col-md-4">
        <input type="text" name="search" value="@Model.Search" placeholder="Search by name..." class="form-control" />
    </div>
    <div class="col-md-4">
        <select name="deptId" class="form-control">
            <option value="">-- All Departments --</option>
            @foreach (var dept in Model.Departments)
            {
                <option value="@dept.Id" selected="@(dept.Id == Model.DeptId)">
                    @dept.Name
                </option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
    <div class="col-md-2">
        <a asp-action="Add" class="btn btn-success w-100">+ New Student</a>
    </div>
</form>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>#</th><th>Name</th><th>Age</th><th>Department</th><th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model.Students)
    {
        <tr>
            <td>@s.Id</td>
            <td>@s.Name</td>
            <td>@s.Age</td>
            <td>@s.Department?.Name</td>
            <td>
                <a asp-action="ShowDetails" asp-route-id="@s.Id" class="btn btn-info btn-sm">Details</a>
                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-warning btn-sm">Edit</a>
                <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
<nav aria-label="Page navigation">
    <ul class="pagination">
        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-page="@(Model.CurrentPage - 1)"
               asp-route-search="@Model.Search"
               asp-route-deptId="@Model.DeptId">Previous</a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@i"
                   asp-route-search="@Model.Search"
                   asp-route-deptId="@Model.DeptId">@i</a>
            </li>
        }

        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-page="@(Model.CurrentPage + 1)"
               asp-route-search="@Model.Search"
               asp-route-deptId="@Model.DeptId">Next</a>
        </li>
    </ul>
</nav>
