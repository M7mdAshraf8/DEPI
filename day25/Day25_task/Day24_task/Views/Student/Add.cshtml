@model Student

<h1>Add Student</h1>

<form asp-action="SaveAdd" asp-controller="Student" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-2">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Age"></label>
        <input asp-for="Age" class="form-control" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="DepartmentId">Department</label>
        <select asp-for="DepartmentId"
                asp-items="@(new SelectList(new Day24_task.Models.DepartmentBL().GetAll(), "Id", "Name"))"
                class="form-control">
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success mt-2">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Back</a>
</form>
